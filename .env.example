# 复制为 .env.local 后填入实际值

# ─── 解读数据集（Postgres）───
# 不配置也能排盘，只是 /api/reading 和 /api/search 不可用
DATABASE_URL=postgresql://ziwei:ziwei_dev_pwd@127.0.0.1:5435/ziwei
DATABASE_POOL_MAX=10

# ─── AI 解读（任何 OpenAI 兼容协议的服务）───
# 不配置时 /api/interpret 返回 503，排盘与数据集解读照常可用
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your-api-key
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=90000
AI_MAX_TOKENS=3000
AI_RATE_LIMIT_PER_MIN=12

# ─── 或用 AI_PROVIDER 预设 ───
# AI_PROVIDER=deepseek  → 需要 DEEPSEEK_API_KEY（可选 DEEPSEEK_MODEL）
# AI_PROVIDER=openai    → 需要 OPENAI_API_KEY（可选 OPENAI_MODEL）
# AI_PROVIDER=mimo      → 需要 MIMO_API_KEY + MIMO_BASE_URL + MIMO_MODEL

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
